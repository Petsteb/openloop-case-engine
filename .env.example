# Copy to .env (never commit .env). Everything works offline with the defaults below.

# Agent planner: scripted (deterministic, no keys) | bedrock (Claude on Amazon Bedrock)
AGENT_MODE=scripted
# Bedrock API key (read automatically by the Anthropic SDK's Mantle client) + region of that key
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=eu-central-1
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
AGENT_EFFORT=low

# Fuzzy judge: heuristic (offline) | featherless (Simple JEV classifier)
JUDGE_MODE=heuristic
FEATHERLESS_API_KEY=
# Without a key the public demo endpoint is used (2k-token context, 2 req/s)
FEATHERLESS_MODEL=featherless-ai/Qwen3.6-35B-A3B-classifier
