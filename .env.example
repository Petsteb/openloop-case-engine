# Copy to .env (never commit .env). Everything works offline with the defaults below.

# Agent planner: scripted (deterministic, no keys) | bedrock (Claude on Amazon Bedrock)
AGENT_MODE=scripted
# Bedrock API key + region. Our account only allows bedrock-runtime in us-east-1 (EU regions denied by policy).
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# Must be an inference profile ID (us./global./eu. prefix), not the bare model ID
BEDROCK_MODEL_ID=us.anthropic.claude-opus-5-5
AGENT_EFFORT=low

# Fuzzy judge: heuristic (offline) | featherless (Simple JEV classifier)
JUDGE_MODE=heuristic
FEATHERLESS_API_KEY=
# With a key (production endpoint) this model works; without a key the public demo endpoint
# uses featherless-ai/Qwen3.6-35B-A3B-classifier (2k-token context, 2 req/s)
FEATHERLESS_MODEL=featherless-ai/gemma-4-26B-A4B-classifier
