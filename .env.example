# Copy to .env (never commit .env). Everything works offline with the defaults below.

# Agent planner: scripted (deterministic, no keys) | bedrock (Claude on Amazon Bedrock)
AGENT_MODE=scripted
# Bedrock API key + region. Our account only allows bedrock-runtime in us-east-1 (EU regions denied by policy).
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# Must be an inference profile ID (us./global./eu. prefix), not the bare model ID
BEDROCK_MODEL_ID=us.anthropic.claude-opus-5-5
AGENT_EFFORT=low

# Fuzzy judge: heuristic (offline) | featherless (Simple JEV classifier)
JUDGE_MODE=heuristic
FEATHERLESS_API_KEY=
# With a key (production endpoint) this model works; without a key the public demo endpoint
# uses featherless-ai/Qwen3.6-35B-A3B-classifier (2k-token context, 2 req/s)
FEATHERLESS_MODEL=featherless-ai/gemma-4-26B-A4B-classifier

# Client emails: outbox (default, shown in the UI, nothing is sent) | gmail (SMTP with an app password)
EMAIL_MODE=outbox
GMAIL_USER=
# Create at https://myaccount.google.com/apppasswords (needs 2-step verification)
GMAIL_APP_PASSWORD=
# Demo safety: all client mail goes to this team inbox instead of the fictional client
NOTIFY_TO=

# Login and access control (backend/app/auth.py, docs/auth.md)
# on (default): every page and /api route needs a session; off: the open demo with no login
OPENLOOP_AUTH=on
# Required in production (any long random string); unset = a new key per process, so sessions end on restart
SESSION_SECRET=
# 1 = the login page lists the synthetic demo accounts and their live one-time codes (demo only; 0 in production)
DEMO_LOGINS=1
# Password of the seeded demo accounts; OPENLOOP_SEED_USERS=0 seeds none (create users with `python -m app.auth add`)
DEMO_PASSWORD=demo
OPENLOOP_SEED_USERS=1
# 1 = the demo controls (time skip, scripted events, reset, registry switch) exist; 0 in production
DEMO_MODE=1
# Google Sign-In (optional): an OAuth web client ID; add this server's URL to its "Authorized JavaScript origins"
GOOGLE_CLIENT_ID=
# Extra browser origins allowed to send writes (comma-separated), e.g. the Vite dev server
TRUSTED_ORIGINS=http://localhost:5173
